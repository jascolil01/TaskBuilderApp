# Netlify cache rules.
#
# The service worker and the HTML shell must never be served from the HTTP
# cache: if the browser reuses a cached sw.js it never notices a new deploy,
# and no amount of client-side update checking helps.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

# Build output is content-hashed, so it's safe to cache these forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
